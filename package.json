{
  "name": "excalidraw-frzn",
  "version": "0.3.1",
  "description": "Workspace desktop local para desenhos e código",
  "main": "./out/main/index.js",
  "author": "Thiago Arthur",
  "license": "MIT",
  "scripts": {
    "electron:check": "node scripts/check-electron.cjs",
    "electron:repair": "node scripts/repair-electron.cjs",
    "predev": "npm run electron:check",
    "dev": "electron-vite dev",
    "prepreview": "npm run electron:check",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "pretest:smoke": "npm run electron:check",
    "test:smoke": "npm run build && tsx scripts/smoke.ts",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:portable": "npm run build && electron-builder --win portable",
    "pack": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "@monaco-editor/react": "^4.7.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shiki": "^3.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "45.3.1",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "playwright": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.frzn.excalidraw",
    "productName": "Excalidraw FRZN",
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "extraResources": [{ "from": "licenses", "to": "licenses" }, { "from": "build/frzn.ico", "to": "frzn.ico" }],
    "directories": { "output": "release" },
    "files": ["out/**/*", "package.json", "!node_modules/**/*"],
    "asar": true,
    "win": { "target": ["nsis"], "icon": "build/frzn.ico", "signExecutable": false },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true },
    "fileAssociations": [{ "ext": "excalidraw", "name": "Desenho Excalidraw", "role": "Editor" }]
  }
}
